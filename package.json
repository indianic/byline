{
  "name": "@indianic/byline",
  "version": "1.7.1",
  "description": "Turn an idea into a finished, published article in your own voice — an MCP server and CLI that researches, writes, illustrates and publishes to Ghost and WordPress from any AI tool.",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.indianic.in/"
  },
  "bin": {
    "byline": "bin/byline.js",
    "mcp-byline": "bin/byline.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "bin",
    "README.md",
    "personas/_template.yaml"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Sandeep Mundra <sandeep@indianic.com>",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ghost",
    "wordpress",
    "blogging",
    "publishing",
    "ai-writing",
    "persona",
    "claude",
    "cursor"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indianic/byline.git"
  },
  "homepage": "https://github.com/indianic/byline#readme",
  "bugs": {
    "url": "https://github.com/indianic/byline/issues"
  }
}
