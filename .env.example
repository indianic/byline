# Ghost Admin API keys — format is id:secret (both hex, from Ghost Admin > Integrations)
PERSONAL_GHOST_KEY=
COMPANY_GHOST_KEY=
SECOND_GHOST_KEY=

# Image generation
GEMINI_API_KEY=
XAI_API_KEY=

# Set to 1 to run integration tests that hit real APIs (targets the personal blog only)
RUN_INTEGRATION=

# Research providers — OPTIONAL. Byline works without these; most agents already
# have web access. Configure one for recency you can check and citable provenance.
# Set BYLINE_RESEARCH_PROVIDER to pin a default when both are configured.
BRAVE_API_KEY=
TAVILY_API_KEY=
BYLINE_RESEARCH_PROVIDER=
